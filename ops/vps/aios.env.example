# Copie para /home/aios/.aios.env (chmod 600). Nunca versione o arquivo real.
AIOS_HOST=vps
AIOS_TELEGRAM_TOKEN=123456:ABC...        # @BotFather
AIOS_TELEGRAM_ALLOWED=111111111          # seu chat_id (só ele é atendido)
AIOS_WHISPER_MODEL=small                 # voz → texto (pip install faster-whisper)
# Opcional, em vez de login interativo: token de 1 ano gerado com `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=...
